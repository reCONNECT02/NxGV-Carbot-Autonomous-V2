<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carbot_common</name>
  <version>0.1.0</version>
  <description>Shared Python library: topic registry, frames, QoS, node base class, YAML data loaders, V4 geometry helpers.</description>
  <maintainer email="risabot@todo.todo">RISA team</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>carbot_interfaces</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
