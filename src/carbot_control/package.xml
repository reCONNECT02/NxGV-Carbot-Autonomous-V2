<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carbot_control</name>
  <version>0.1.0</version>
  <description>Blocks 14-16: safety checks, the single command owner (actuator mapping to the base servo_controller) and the tunnel bridge.</description>
