<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carbot_gui</name>
  <version>0.1.0</version>
  <description>Browser GUI (calibrate / race modes): Drive tab + diagnostic tabs, lazy subscriptions, tuning, manual control.</description>
  <maintainer email="risabot@todo.todo">RISA team</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>carbot_interfaces</depend>
  <depend>carbot_common</depend>
  <depend>risabot_automode</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>ament_index_python</depend>
  <depend>python3-yaml</depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
