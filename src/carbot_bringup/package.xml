<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carbot_bringup</name>
  <version>0.1.0</version>
  <description>Launch entry points (race.launch.py, calibrate.launch.py), YAML parameters and data files, root helper scripts.</description>
  <maintainer email="risabot@todo.todo">RISA team</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- reused base-repo packages -->
  <exec_depend>astra_camera</exec_depend>
  <exec_depend>ydlidar_ros2_driver</exec_depend>
  <exec_depend>control_servo</exec_depend>
  <exec_depend>risabot_automode</exec_depend>

  <!-- carbot stack -->
  <exec_depend>carbot_interfaces</exec_depend>
  <exec_depend>carbot_common</exec_depend>
  <exec_depend>carbot_perception</exec_depend>
  <exec_depend>uwb_localization</exec_depend>
  <exec_depend>carbot_localization</exec_depend>
  <exec_depend>carbot_planning</exec_depend>
  <exec_depend>carbot_control</exec_depend>
  <exec_depend>carbot_detectors</exec_depend>
  <exec_depend>carbot_ops</exec_depend>
  <exec_depend>carbot_gui</exec_depend>
  <!-- mipi_cam (TogetheROS, /opt/tros) and micro_ros_agent (~/uros_ws) are
       started through scripts/, not declared here: they are not on the
       normal package path. See docs/SETUP.md. -->

  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
