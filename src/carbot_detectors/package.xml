<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carbot_detectors</name>
  <version>0.1.0</version>
  <description>Traffic light (red/green), speed-bump sign and boom gate (open/closed) recognition on the RDK X5 BPU.</description>
  <maintainer email="risabot@todo.todo">RISA team</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>carbot_interfaces</depend>
  <depend>carbot_common</depend>
  <depend>cv_bridge</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
