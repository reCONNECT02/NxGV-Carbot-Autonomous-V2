<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uwb_localization</name>
  <version>0.1.0</version>
  <description>Parses the micro-ROS UWB tag JSON (/uwb3/input_json) into per-anchor ranges for block 06. UWB never reaches the servo.</description>
  <maintainer email="risabot@todo.todo">RISA team</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>carbot_interfaces</depend>
  <depend>carbot_common</depend>
  <depend>nav_msgs</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>  <!-- only for uwb_positioning.solver: nlls; falls back without it -->
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
