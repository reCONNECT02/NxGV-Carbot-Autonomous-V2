{
  // Phase-2 node sandboxes (no ROS). Run with F5 after picking one in the
  // Run and Debug panel. Setup: tools/sandbox/README.md
  "version": "0.2.0",
  "configurations": [
    {
      "name": "07-13 planning: drive the whole mission (team map)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_planning.py",
      "cwd": "${workspaceFolder}", "args": []
    },
    {
      "name": "07-13 planning: V4 reference map (hybrid A* planning)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_planning.py",
      "cwd": "${workspaceFolder}", "args": ["--v4"]
    },
    {
      "name": "07-13 planning: boom gate stays closed (must hold, no timer)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_planning.py",
      "cwd": "${workspaceFolder}", "args": ["--gate-closed", "--t-max", "200"]
    },
    {
      "name": "03 road_perception: start line (synthetic)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_road_perception.py",
      "cwd": "${workspaceFolder}", "args": []
    },
    {
      "name": "03 road_perception: drive the demo route",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_road_perception.py",
      "cwd": "${workspaceFolder}", "args": ["--drive"]
    },
    {
      "name": "03 road_perception: drive 6 cm off-centre, 8 deg yaw error",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_road_perception.py",
      "cwd": "${workspaceFolder}", "args": ["--drive", "--offset", "0.06", "--yaw-error", "8"]
    },
    {
      "name": "03 road_perception: fisheye lens WITHOUT calibration (mismatch)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_road_perception.py",
      "cwd": "${workspaceFolder}", "args": ["--lens", "fisheye", "--mismatch", "--drive"]
    },
    {
      "name": "03 road_perception: recorded videos (edit paths)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_road_perception.py",
      "cwd": "${workspaceFolder}",
      "args": ["--source", "video", "--video", "front=C:/videos/front.mp4"]
    },
    {
      "name": "04 local_memory: demo route",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_local_memory.py",
      "cwd": "${workspaceFolder}", "args": []
    },
    {
      "name": "04 local_memory: bad odometry (3% scale, 1.5 deg/s drift)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_local_memory.py",
      "cwd": "${workspaceFolder}", "args": ["--drift-pct", "3", "--yaw-drift-deg-s", "1.5"]
    },
    {
      "name": "camera_preview: synthetic",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_camera_preview.py",
      "cwd": "${workspaceFolder}", "args": []
    },
    {
      "name": "camera_preview: laptop webcam as front",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_camera_preview.py",
      "cwd": "${workspaceFolder}", "args": ["--source", "webcam", "--webcam", "front=0"]
    },
    {
      "name": "step 3 intrinsics: synthetic fisheye lens",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_calib_intrinsics.py",
      "cwd": "${workspaceFolder}", "args": ["--synth", "fisheye"]
    },
    {
      "name": "step 3 intrinsics: live laptop webcam",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_calib_intrinsics.py",
      "cwd": "${workspaceFolder}", "args": ["--webcam", "0"]
    },
    {
      "name": "step 4 extrinsics: synthetic floor boards",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_calib_extrinsics.py",
      "cwd": "${workspaceFolder}", "args": ["--synth"]
    },
    {
      "name": "step 4 extrinsics: synthetic, fisheye side lenses, 4 deg mount error",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_calib_extrinsics.py",
      "cwd": "${workspaceFolder}", "args": ["--synth", "--lens", "fisheye", "--perturb-deg", "4"]
    }
    ,
    {
      "name": "05/06 localization: simulated lap",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_localization.py",
      "cwd": "${workspaceFolder}", "args": []
    },
    {
      "name": "05/06 localization: bad start + missing anchor + heavy multipath",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_localization.py",
      "cwd": "${workspaceFolder}", "args": ["--start-error", "0.3", "--drop", "1783", "--spikes", "0.15"]
    },
    {
      "name": "05/06 localization: cameras off (dead reckoning + UWB only)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_localization.py",
      "cwd": "${workspaceFolder}", "args": ["--no-camera"]
    },
    {
      "name": "05/06 localization: replay a rosbag from the car (edit paths)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/run_localization.py",
      "cwd": "${workspaceFolder}",
      "args": ["--bag", "C:/bags/run_1", "--session", "C:/carbot_data/calibration/20260925_081500"]
    },
    {
      "name": "GUI mock: race mode, car stopped (open http://localhost:8081)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/gui_mock_server.py",
      "cwd": "${workspaceFolder}", "args": ["--mode", "race", "--scenario", "stop"]
    },
    {
      "name": "GUI mock: calibrate mode (open http://localhost:8081)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/tools/sandbox/gui_mock_server.py",
      "cwd": "${workspaceFolder}", "args": ["--mode", "calibrate"]
    }
  ]
}
