    roll_deg: 0.0, hfov_deg: 60.0}
  left_rear: {x_m: 0.1145, y_m: 0.0654, z_m: 0.1406, yaw_deg: 95.0, pitch_down_deg: 10.0,
    roll_deg: 0.0, hfov_deg: 70.0}
  right_rear: {x_m: 0.1145, y_m: -0.0654, z_m: 0.1406, yaw_deg: -95.0, pitch_down_deg: 10.0,
    roll_deg: 0.0, hfov_deg: 70.0}
