    image_height: 544, image_topic: /cam_imx219/image_raw, encoding: bgr8, expected_hz: 30.0,
    hardware: 'IMX219 v2.1, MIPI host 0, I2C bus 6, addr 0x10', intrinsics_file: ''}
roles: {front: astra, left_rear: imx219, right_rear: ov5647}
