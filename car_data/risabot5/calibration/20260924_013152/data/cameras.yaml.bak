    image_height: 544, image_topic: /cam_ov5647/image_raw, encoding: bgr8, expected_hz: 30.0,
    hardware: 'OV5647 Rev1.3, MIPI host 2, I2C bus 4, addr 0x36', intrinsics_file: ''}
