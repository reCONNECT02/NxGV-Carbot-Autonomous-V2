version: 1
sensors:
  astra: {enabled: true, driver: astra_camera, launch_file: astra_mini.launch.py,
    image_topic: /camera/color/image_raw, width: 640, height: 480, encoding: rgb8,
    expected_hz: 30.0, intrinsics_file: ''}
